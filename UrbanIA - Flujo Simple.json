    {
      "parameters": {
        "jsCode": "// BUG CORREGIDO: el formulario envía multipart/form-data.\n// n8n lo expone en $input.first().json directamente (no en .body).\n// Se prueban ambas rutas para máxima compatibilidad.\n\nconst item = $input.first();\nconst body = item.json?.body || item.json || {};\n\n// Log para debug — ver en n8n Execution qué llegó\nconsole.log('Payload recibido:', JSON.stringify(body));\n\nreturn [{\n  json: {\n    tokenId:       body.tokenId       || 'URB-' + Date.now(),\n    nombre:        body.nombre        || '',\n    email:         body.email         || '',\n    telefono:      body.telefono      || '',\n    tipoIncidente: body.tipoIncidente || '',\n    descripcion:   body.descripcion   || '',\n    latitud:       body.latitud       || '',\n    longitud:      body.longitud      || '',\n    fecha:         new Date().toISOString(),\n    tieneImagen:   Object.keys(item.binary || {}).length > 0\n  }\n}];"
      },
      "id": "8a242610-ee73-4058-88a4-ba91c7383fe7",
      "name": "Extraer Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        1760
      ]
    },
    {
      "parameters": {
        "text": "Eres un experto en infraestructura urbana y visión artificial. Analiza la siguiente descripción del ciudadano: '{{ $json.descripcion }}'. Tipo de incidente reportado: {{ $json.tipoIncidente }}.\n\nResponde ÚNICAMENTE con un objeto JSON válido (sin markdown, sin bloques de código, sin texto extra) con esta estructura exacta:\n{\n  \"tipo_incidente\": \"bache|cableado|fuga|alumbrado|otro\",\n  \"severidad\": \"Crítica|Moderada|Baja\",\n  \"score_confianza\": 85,\n  \"riesgo_inmediato\": false,\n  \"resumen_tecnico\": \"Descripción técnica breve del daño\",\n  \"accion_recomendada\": \"despacho_inmediato|validacion_manual|monitoreo\"\n}",
        "options": {
          "systemMessage": "Responde siempre en formato JSON puro. No incluyas explicaciones adicionales."
        }
      },
      "id": "554b1153-dbb3-4295-b806-263c81d5bb64",
      "name": "AI Agent - Análisis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        96,
        1760
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output;\nlet cleanJson = aiOutput.replace(/```json/g, '').replace(/```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(cleanJson);\n  return [{ json: { ...$input.first().json, aiAnalysis: parsed } }];\n} catch (e) {\n  // Si no parsea, crear un análisis por defecto para no romper el flujo\n  return [{ json: { ...$input.first().json, aiAnalysis: {\n    tipo_incidente: $input.first().json.tipoIncidente || 'otro',\n    severidad: 'Moderada',\n    score_confianza: 50,\n    riesgo_inmediato: false,\n    resumen_tecnico: $input.first().json.descripcion || 'Sin análisis disponible',\n    accion_recomendada: 'validacion_manual',\n    error: 'No se pudo parsear la respuesta de la IA'\n  } } }];\n}"
      },
      "id": "57b4abb3-b5d8-46ae-ab2d-84ce73724bbc",
      "name": "Parsear Respuesta IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        1760
      ]
    },

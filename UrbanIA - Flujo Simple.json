    {
      "parameters": {
        "text": "=Eres un experto en infraestructura urbana. Descripción del ciudadano: '{{ $json.descripcion }}'. Tipo: {{ $json.tipoIncidente }}.\n\nResponde ÚNICAMENTE con JSON puro sin markdown:\n{\n  \"tipo_incidente\": \"bache|cableado|fuga|alumbrado|otro\",\n  \"severidad\": \"Crítica|Moderada|Baja\",\n  \"score_confianza\": 75,\n  \"riesgo_inmediato\": false,\n  \"resumen_tecnico\": \"descripción breve\",\n  \"accion_recomendada\": \"despacho_inmediato|validacion_manual|monitoreo\"\n}",
        "options": {
          "systemMessage": "Solo JSON puro. Sin texto adicional ni bloques de código."
        }
      },

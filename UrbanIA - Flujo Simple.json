    {
      "parameters": {
        "jsCode": "const h1 = $('Google Sheets - Leer Hoja ').all();\nconst h2 = $('Google Sheets - Leer Hoja 3').all();\n\n// Contadores de severidad\nlet criticos  = 0;\nlet moderados = 0;\nlet bajos     = 0;\n\n// Tipos de incidente\nconst tipoConteo = {};\n\nh2.forEach(r => {\n  const s = (r.json.Severidad || '').trim();\n  if (s === 'Crítica' || s === 'Critica') criticos++;\n  else if (s === 'Moderada')              moderados++;\n  else if (s === 'Baja')                  bajos++;\n});\n\nh1.forEach(r => {\n  const tipo = (r.json['Tipo De Incidente'] || 'otro').trim();\n  tipoConteo[tipo] = (tipoConteo[tipo] || 0) + 1;\n});\n\n// Último incidente registrado\nconst ultimo = h1.length > 0\n  ? {\n      token:    h1[h1.length - 1].json.Tokenid,\n      tipo:     h1[h1.length - 1].json['Tipo De Incidente'],\n      fecha:    h1[h1.length - 1].json.Fecha\n    }\n  : null;\n\nreturn [{\n  json: {\n    // Lo que el frontend necesita\n    totales:  h1.length,\n    criticos,\n    moderados,\n    bajos,\n    // Extra para evaluación académica\n    por_tipo:       tipoConteo,\n    ultimo_reporte: ultimo,\n    timestamp:      new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' }),\n    metricas_generales: {\n      total_incidentes:    h1.length,\n      incidentes_criticos: criticos,\n      incidentes_moderados:moderados,\n      incidentes_bajos:    bajos,\n      tasa_criticos: h1.length > 0\n        ? ((criticos / h1.length) * 100).toFixed(1) + '%'\n        : '0%'\n    }\n  }\n}];"
      },

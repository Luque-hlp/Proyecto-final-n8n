        "jsCode": "const hoja1 = $('Buscar Hoja 1').all();\nconst hoja2 = $('Buscar Hoja 2').all();\n\nif (hoja1.length === 0) {\n  return [{ json: { success: false, error: 'Token no encontrado en la base de datos.' } }];\n}\n\nconst datos = hoja1[0].json;\nconst ia    = hoja2.length > 0 ? hoja2[0].json : null;\n\nreturn [{\n  json: {\n    success:            true,\n    token:              datos.Tokenid,\n    ciudadano:          datos.Nombre_Ciudadano    || 'Anónimo',\n    tipo_incidente:     datos['Tipo De Incidente'] || 'No especificado',\n    severidad:          ia?.Severidad             || 'Evaluando',\n    score:              ia?.Score                 || 0,\n    diagnostico:        ia?.Resumen               || 'Sin diagnóstico disponible aún.',\n    accion_recomendada: ia?.['Acción']             || 'Despachar cuadrilla estándar.',\n    latitud:            datos.Latitud,\n    longitud:           datos.Longitud,\n    fecha:              datos.Fecha               || new Date().toISOString()\n  }\n}];"

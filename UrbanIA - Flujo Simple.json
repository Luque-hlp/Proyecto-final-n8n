      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = item.json?.body || item.json || {};\n\nconst get = (key) => body[key] ?? '';\n\n// El token viene del frontend o se genera aquí\nconst token = get('token') || ('URB-' + Date.now());\n\nreturn [{\n  json: {\n    tokenId:       token,\n    nombre:        get('ciudadano'),      // ← el frontend envía 'ciudadano'\n    email:         get('correo'),         // ← el frontend envía 'correo'\n    telefono:      get('telefono'),\n    tipoIncidente: get('tipo_incidente'), // ← el frontend envía 'tipo_incidente'\n    descripcion:   get('descripcion'),\n    latitud:       get('latitud'),\n    longitud:      get('longitud'),\n    fecha:         new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' }),\n    tieneImagen:   Object.keys(item.binary || {}).length > 0\n  }\n}];"
      },

        1936,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst clean = raw.replace(/```json/g,'').replace(/```/g,'').trim();\ntry {\n  const ai = JSON.parse(clean);\n  return [{ json: { ...$input.first().json, aiAnalysis: ai } }];\n} catch(e) {\n  return [{ json: { ...$input.first().json, aiAnalysis: {\n    tipo_incidente: $input.first().json.tipoIncidente || 'otro',\n    severidad: 'Moderada', score_confianza: 50,\n    riesgo_inmediato: false,\n    resumen_tecnico: $input.first().json.descripcion || 'Sin análisis',\n    accion_recomendada: 'validacion_manual'\n  }}}];\n}"
      },

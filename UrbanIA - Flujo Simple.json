    {
      "parameters": {
        "jsCode": "const hoja1Data = $('Google Sheets - Leer Hoja 1').all();\nconst hoja2Data = $('Google Sheets - Leer Hoja 2').all();\n\nconst incidentes = hoja1Data.map(item => item.json);\nconst analisisIA = hoja2Data.map(item => item.json);\n\nconst totalIncidentes = incidentes.length;\n\nlet criticos = 0, moderados = 0, bajos = 0, sinClasificar = 0;\nconst tiposIncidente = {};\n\nanalisisIA.forEach(registro => {\n  const severidad = (registro.Severidad || '').trim();\n  if (severidad === 'Crítica' || severidad === 'Critica') criticos++;\n  else if (severidad === 'Moderada') moderados++;\n  else if (severidad === 'Baja') bajos++;\n  else sinClasificar++;\n\n  const tipo = registro['Tipo De Incidente'] || 'sin_clasificar';\n  tiposIncidente[tipo] = (tiposIncidente[tipo] || 0) + 1;\n});\n\nlet scorePromedio = 0, scoresValidos = 0;\nanalisisIA.forEach(r => {\n  const s = parseInt(r.Score) || 0;\n  if (s > 0) { scorePromedio += s; scoresValidos++; }\n});\nscorePromedio = scoresValidos > 0 ? Math.round(scorePromedio / scoresValidos) : 0;\n\nreturn [{\n  json: {\n    exito: true,\n    timestamp: new Date().toISOString(),\n    totales:  totalIncidentes,\n    criticos: criticos,\n    metricas_generales: {\n      total_incidentes:    totalIncidentes,\n      incidentes_criticos: criticos,\n      incidentes_moderados: moderados,\n      incidentes_bajos:    bajos,\n      sin_clasificar:      sinClasificar\n    },\n    analisis_ia: { score_promedio_confianza: scorePromedio, total_analizados: scoresValidos },\n    por_tipo_incidente: tiposIncidente,\n    estado_sistema: {\n      criticos_activos: criticos,\n      requiere_atencion: criticos > 0,\n      nivel_alerta: criticos > 5 ? 'ALTO' : criticos > 2 ? 'MEDIO' : 'BAJO'\n    }\n  }\n}];"
      },

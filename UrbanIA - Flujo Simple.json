        "jsCode": "const d = $input.first().json;\n\nif (!d.success) {\n  return [{\n    json: {\n      mensaje: `❌ *Token no encontrado*\\n\\nEl ID \\`${$('Webhook Consulta1').first().json.query.token}\\` no existe en el sistema.\\n\\nVerifica que el token sea correcto.`\n    }\n  }];\n}\n\nconst emoji = {\n  'Crítica':  '🔴',\n  'Moderada': '🟠',\n  'Baja':     '🟢',\n  'Evaluando':'⚪'\n}[d.severidad] || '⚪';\n\nreturn [{\n  json: {\n    mensaje:\n      `🏙️ *REPORTE URBANIA*\\n\\n` +\n      `🪪 *Token:* \\`${d.token}\\`\\n` +\n      `👤 *Ciudadano:* ${d.ciudadano}\\n` +\n      `📞 *Teléfono:* ${d.telefono}\\n` +\n      `📧 *Correo:* ${d.correo}\\n` +\n      `🔧 *Tipo:* ${d.tipo_incidente}\\n` +\n      `📝 *Descripción:* ${d.descripcion}\\n\\n` +\n      `━━━━━━━━━━━━━━━\\n` +\n      `🤖 *Análisis IA \\\\(Gemini\\\\)*\\n` +\n      `${emoji} *Severidad:* ${d.severidad}\\n` +\n      `📊 *Score:* ${d.score}/100\\n` +\n      `🔬 *Diagnóstico:* ${d.diagnostico}\\n` +\n      `✅ *Acción:* ${d.accion_recomendada}\\n` +\n      `━━━━━━━━━━━━━━━\\n` +\n      `📍 ${d.maps_url || 'Sin coordenadas'}\\n` +\n      `⏰ ${d.fecha}`\n  }\n}];"

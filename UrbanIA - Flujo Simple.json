    {
      "parameters": {
        "jsCode": "const h1 = $('Buscar Hoja ').all();\nconst h2 = $('Buscar Hoja 2').all();\n\n// Si no encontró nada en Hoja 1\nif (h1.length === 0) {\n  return [{\n    json: {\n      success: false,\n      error: 'Token no encontrado. Verifique el ID e intente nuevamente.'\n    }\n  }];\n}\n\nconst d  = h1[0].json;\nconst ia = h2.length > 0 ? h2[0].json : null;\n\n// Severidad con color para el frontend\nconst severidadConfig = {\n  'Crítica':  { nivel: 'Crítica',  color: '#dc2626', score_minimo: 70 },\n  'Moderada': { nivel: 'Moderada', color: '#ea580c', score_minimo: 40 },\n  'Baja':     { nivel: 'Baja',     color: '#16a34a', score_minimo: 0  }\n};\n\nconst severidad = ia?.Severidad || 'Evaluando';\nconst configSev = severidadConfig[severidad] || { color: '#64748b' };\n\nreturn [{\n  json: {\n    success:           true,\n    token:             d.Tokenid             || 'N/A',\n    ciudadano:         d.Nombre_Ciudadano    || 'Anónimo',\n    correo:            d.Correo_Ciudadano    || 'No registrado',\n    telefono:          d.Telefono            || 'No registrado',\n    tipo_incidente:    d['Tipo De Incidente']|| 'No especificado',\n    descripcion:       d.Descripcion         || 'Sin descripción.',\n    latitud:           d.Latitud             || null,\n    longitud:          d.Longitud            || null,\n    fecha:             d.Fecha               || 'Fecha desconocida',\n    // Datos de la IA\n    severidad:         severidad,\n    color_severidad:   configSev.color,\n    score:             ia?.Score             || 0,\n    diagnostico:       ia?.Resumen           || 'Análisis pendiente.',\n    accion_recomendada:ia?.['Acción']        || 'Despachar cuadrilla estándar.',\n    // Enlace directo a Maps\n    maps_url: (d.Latitud && d.Longitud)\n      ? `https://maps.google.com/?q=${d.Latitud},${d.Longitud}`\n      : null\n  }\n}];"
      },
